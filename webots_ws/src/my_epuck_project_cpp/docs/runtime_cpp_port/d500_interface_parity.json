  "scan": {
    "topic": "/scan",
    "production_frame_id": "d500_lidar",
    "bins": 720,
    "min_range_mm": 30,
    "max_range_mm": 12000,
    "scan_timestamp": "host_acquisition_midpoint",
    "mirror_correction": "preserved"
  },
  "status": "parser_golden_parity_in_progress"
}
