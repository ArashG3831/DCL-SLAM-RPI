{
  "python_node": "d500_ros2_scan.py",
  "cpp_node": "d500_ros2_scan_cpp",
  "default_production_backend": "python",
  "protocol": {
    "header": [84, 44],
    "packet_length": 47,
    "points_per_packet": 12,
    "crc_polynomial": "0x4d",
    "baud": 230400,
    "serial_timeout_s": 0.05
