<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>my_epuck_frontier_candidates</name>
  <version>0.0.0</version>
  <description>Hardware-independent frontier candidate generation for cooperative Robot 2 navigation.</description>
  <maintainer email="robot2@todo.todo">robot2</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>frontier_exploration_ros2</depend>
  <depend>geometry_msgs</depend>
  <depend>my_epuck_interfaces</depend>
  <depend>nav2_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>visualization_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
